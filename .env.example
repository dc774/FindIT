# Copy this file to .env and fill in your gateway key:  cp .env.example .env
# .env is gitignored and never committed.
#
# FindIT runs the Claude re-ranking step through the Cornell AI Gateway.
# ANTHROPIC_BASE_URL is the gateway endpoint (no trailing slash).
# ANTHROPIC_AUTH_TOKEN is your gateway key, sent as a Bearer token.
# If either is already exported in your shell, that value takes precedence.
ANTHROPIC_BASE_URL=https://api.ai.it.cornell.edu
ANTHROPIC_AUTH_TOKEN=your-cornell-gateway-key
