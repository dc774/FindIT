# Copy this file to .env and fill in ONE of the options below:  cp .env.example .env
# .env is gitignored and never committed. A value exported in your shell takes
# precedence over this file.
#
# AI re-ranking is optional. With neither option set, FindIT returns raw search
# results and makes no external call.

# Option A: your own Anthropic API key (from the Claude Console, billed pay-as-you-go).
# Note: a Claude Pro chat subscription does not include API access.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Option B: Cornell AI Gateway. ANTHROPIC_BASE_URL is the gateway endpoint
# (no trailing slash); ANTHROPIC_AUTH_TOKEN is your gateway key, sent as a
# Bearer token. If both options are set, the gateway is used.
# ANTHROPIC_BASE_URL=https://api.ai.it.cornell.edu
# ANTHROPIC_AUTH_TOKEN=your-cornell-gateway-key

# Optional: which Claude model re-ranks results (default: claude-haiku-4-5).
# The Cornell AI Gateway accepts only the model IDs it has enabled.
# FINDIT_MODEL=claude-haiku-4-5

# Optional: Cornell brand typeface (Freight Sans Pro) for the browser page.
# Create a web project in Adobe Fonts (fonts.adobe.com) that includes Freight Sans Pro,
# then paste its project ID here (short, lowercase letters and digits). Without it,
# the page uses Palatino plus a system sans-serif and makes no outside requests.
# FINDIT_ADOBE_FONTS_ID=abc1234
